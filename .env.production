# Environment: Production
# Description: Environment variables for the production environment.

# VITE_TVMAZE_API_URL is the base URL for the TVMaze public API.
VITE_TVMAZE_API_URL="https://api.tvmaze.com"
# VITE_SHOWS_ENDPOINT_PATH is the path to the shows endpoint.
VITE_SHOWS_ENDPOINT_PATH="/shows"
# VITE_LOGO_API_URL is the base URL for the Logo.dev API.
VITE_LOGO_API_URL="https://img.logo.dev"
# VITE_LOGO_PUBLISHABLE_API_KEY is the publishable API key for the Logo.dev API.
VITE_LOGO_PUBLISHABLE_API_KEY=""
# VITE_CLIENT_DOMAIN is the client's official website domain, used to fetch its logo.
VITE_CLIENT_DOMAIN="tvmaze.com"
# VITE_PRIME_UI_LICENSE_KEY is the license key for the PrimeUI (PrimeVue) library.
